  "deployment_strategy": {
    "recommended": "Cloudflare Workers + Durable Objects",
    "alternatives": [
      "AWS Lambda + API Gateway + DynamoDB/RDS",
      "Local Docker stack with Home Assistant"
    ],
    "security_model": {
      "principles": [
        "GPT has no direct access to Home Assistant; backend mediates all calls",
        "backend enforces schema validation and safety constraints",
        "all deployments are logged",
        "optional human-approval mode for high-risk operations"
      ]
