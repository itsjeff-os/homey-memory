# Environment variables
#
# Copy this file to .env and fill in real values locally. Never commit .env.
# This file only documents which variables each backend/integration expects.

# --- memory/supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- memory/chroma ---
CHROMA_URL=
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=

# --- memory/zep ---
ZEP_API_URL=
ZEP_API_KEY=

# --- cloudflare-workers ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- home-assistant ---
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
